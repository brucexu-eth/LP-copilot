# Local server only. No signing keys.
HOST=127.0.0.1
PORT=3400
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Create a personal key at https://thegraph.com/studio/apikeys/
# Studio > API Keys > Create API Key. Optional for public pool reads.
GRAPH_API_KEY=
# Explicit development fixture only. live never silently falls back to mock.
GRAPH_MODE=live
# AI credentials are server-only. Missing key disables chat, not fake AI.
# Create at https://platform.deepseek.com/api_keys
# Leave empty until a real key is available; do not insert dummy values.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LP_DATA_DIR=./data
# Runtime-only Privy credentials; never use VITE_ for secrets.
# Create a development app: https://dashboard.privy.io/
# Configuration > App settings > Basics: App ID and App Secret.
# Enable email login; when restricting origins include your local origin.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma-separated exact Privy DIDs. Empty denies all private API access.
# After login, copy your exact user ID (did:privy:...) from Privy.
# This is a user ID, not an email address or wallet address.
PRIVY_ALLOWED_USER_IDS=

# Optional local simulation: npm run dev:mock overrides these switches.
ENABLE_SIMULATION_LAB=0
SIMULATION_DB_PATH=./data/simulation.sqlite
# Optional origin override; normally keep unset.
# APP_ORIGIN=http://127.0.0.1:3400
# Hosted Docker requires HOST=0.0.0.0, an exact HTTPS APP_ORIGIN,
# Privy credentials/allowlist, and explicit activation.
ENABLE_HOSTED_TESTNET=0

# Same-chain Graph evidence for the Base Sepolia position manager.
# The deployment key is optional at runtime and is used only to deploy the indexer.
GRAPH_STUDIO_DEPLOY_KEY=
BASE_SEPOLIA_GRAPH_URL=
