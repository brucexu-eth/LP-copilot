# Local server only. No signing keys.
HOST=127.0.0.1
PORT=3400
ETH_RPC_URL=https://1rpc.io/eth
# Create a personal key at https://thegraph.com/studio/apikeys/
GRAPH_API_KEY=
# Explicit development fixture only. live never silently falls back to mock.
GRAPH_MODE=live
# AI credentials are server-only. Missing key disables chat, not fake AI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LP_DATA_DIR=./data
# Runtime-only Privy credentials; never use VITE_ for secrets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma-separated exact Privy DIDs. Empty denies all private API access.
PRIVY_ALLOWED_USER_IDS=
