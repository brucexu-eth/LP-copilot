{
  "name": "lp-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A read-only Uniswap v3 position learning and comparison workbench",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "vite build",
    "predev": "npm run build",
    "dev": "node --env-file=.env server.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js && npm test && npm run build",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.42.0",
    "@uniswap/sdk-core": "7.19.2",
    "@uniswap/v3-sdk": "3.31.3",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3"
  }
}
